<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FlashQuiz.Create"
             xmlns:ViewModels="clr-namespace:FlashQuiz.ViewModels"
             Title="Create"
             BackgroundColor="White">
    <ContentPage.BindingContext>
        <ViewModels:Mvvm1ViewModel x:Name="vm"/>
    </ContentPage.BindingContext>
    
    <VerticalStackLayout Spacing="20">
        <Label 
            Text="FlashQuiz"
            VerticalOptions="Center" 
            HorizontalOptions="Center" WidthRequest="100" HeightRequest="50" TextColor="Black" Padding="10" FontAttributes="Bold"/>

        <HorizontalStackLayout HorizontalOptions="Center">
            <Border Stroke="Transparent">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="30" />
                </Border.StrokeShape>
                <Entry Text="{Binding Titre}" Placeholder="Question..."  WidthRequest="380" HeightRequest="40" BackgroundColor="#D9D9D9" TextColor="#6F6767" FontAttributes="Bold"/>

            </Border>
        </HorizontalStackLayout>
        
        <HorizontalStackLayout HorizontalOptions="Center" >
            <Border Stroke="Transparent">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Entry Text="{Binding Definition}" Placeholder="Réponse..." WidthRequest="380" HeightRequest="250" BackgroundColor="#D9D9D9" TextColor="#6F6767" FontAttributes="Bold"/>

            </Border>
        </HorizontalStackLayout>
        
        <HorizontalStackLayout HorizontalOptions="End">

            <Button x:Name="AddButton"
                Text="Create"
                Command="{Binding AddCardCommand}"
                MaximumWidthRequest="300"
                IsEnabled="{Binding Source={x:Reference AddButton}, Path=Command.CanExecute}" VerticalOptions="Start" HorizontalOptions="Start" WidthRequest="100" HeightRequest="40" BackgroundColor="#78D390" Margin="60" TextColor="White" FontAttributes="Bold">
            <Button.Triggers>
                <Trigger TargetType="Button" Property="IsEnabled" Value="True">
                    <Setter Property="BackgroundColor" Value="Green" />
                </Trigger>
                <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                    <Setter Property="BackgroundColor" Value="Gray" />
                </Trigger>
            </Button.Triggers>
        </Button>
        </HorizontalStackLayout>



    </VerticalStackLayout>
</ContentPage>