<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FlashQuiz.List"
             xmlns:ViewModels="clr-namespace:FlashQuiz.ViewModels"
             Title="List">

    <ContentPage.BindingContext>
        <ViewModels:Mvvm1ViewModel x:Name="vm"/>
    </ContentPage.BindingContext>

    <VerticalStackLayout Spacing="10" BackgroundColor="#d9d9d9">


        <CollectionView Margin="0, 5, 0, 0" SelectionMode="None" ItemsSource="{Binding Cards}" SelectedItem="{Binding SelectedCard, Mode=TwoWay}" VerticalOptions="FillAndExpand">

            <CollectionView.ItemTemplate >
                <DataTemplate >
                    <HorizontalStackLayout Margin="5" BackgroundColor="white">
                            <VerticalStackLayout Grid.Column="0" Grid.ColumnSpan="2" >
                                    <HorizontalStackLayout HorizontalOptions="Center" Margin="5">
                                    <Border Stroke="Transparent">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding Titre}" Padding="5" WidthRequest="300" HeightRequest="40" BackgroundColor="#D9D9D9" TextColor="#6F6767" FontAttributes="Bold" FontSize="Medium" VerticalOptions="Center" HorizontalOptions="Center"/>

                                    </Border>
                                </HorizontalStackLayout >
                                <HorizontalStackLayout HorizontalOptions="Center" Margin="5">
                                    <Border Stroke="Transparent">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding Definition}"  Padding="5" WidthRequest="300" HeightRequest="40" BackgroundColor="#6F6767" TextColor="#D9D9D9" FontAttributes="Bold" FontSize="Medium" VerticalOptions="Center" HorizontalOptions="Center"/>

                                    </Border>
                                </HorizontalStackLayout>
                            </VerticalStackLayout >
                            <VerticalStackLayout>
                                <ImageButton Grid.Column="1" Source="edit.png"  WidthRequest="50" HeightRequest="50" Command="{Binding Source={x:Reference vm}, Path=EditCommand}" CommandParameter="{Binding .}"/>

                                <ImageButton Grid.Column="2" Source="delete.png"
                            Command="{Binding Source={x:Reference vm}, Path=DeleteCommand}"
                            CommandParameter="{Binding .}" WidthRequest="50" HeightRequest="50"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>